# Application port inside the container (leave at 3000)
PORT=3000

# Host port published to the network. On RPLab CT104 use 8191 (8190 is radio-nginx).
HOST_PORT=3000

# Environment mode (development or production)
NODE_ENV=production

# Persistent storage directory inside the container
DATA_DIR=/app/data

# Music library on the host: an absolute path bind-mounts from the host,
# otherwise a name resolves to a Docker named volume.
MUSIC_HOST_DIR=./music

# Public URL of this instance (used for self-referential links & CORS)
APP_URL="http://localhost:3000"

# Admin dashboard credentials (REQUIRED in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me